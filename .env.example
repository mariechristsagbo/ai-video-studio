DATABASE_URL=
REDIS_URL=redis://redis:6379
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
RESEND_API_KEY=
RESEND_FROM_EMAIL=
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_TEXT_MODEL=agnes-2.5-flash
AGNES_VIDEO_MODEL=agnes-video-2.5
VIDEO_GENERATION_CONCURRENCY=3
RENDER_CONCURRENCY=1
DATA_DIR=/app/data

# Media storage: local (default) or cloudinary
STORAGE_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ai-video-studio
# private (default, signed download URLs), authenticated or upload (public CDN)
CLOUDINARY_DELIVERY_TYPE=private
# Serve playback through the app proxy (default) or redirect to a short-lived signed URL
CLOUDINARY_DIRECT_DELIVERY=false
